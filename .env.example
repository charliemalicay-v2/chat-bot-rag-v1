# Copy to .env and change the passwords. .env is git-ignored.

# --- MySQL (db container) ---
MYSQL_DATABASE=chatbot
MYSQL_USER=chatbot
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=db
MYSQL_PORT=3306
# Published on 127.0.0.1 only; change if 3307 is taken.
MYSQL_HOST_PORT=3307

# --- PostgreSQL + pgvector (vector container) ---
POSTGRES_DB=vectors
POSTGRES_USER=vectors
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=vector
POSTGRES_PORT=5432
# Published on 127.0.0.1 only; change if 5433 is taken.
POSTGRES_HOST_PORT=5433

# --- Django (used from Phase 1) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- LLM / embeddings (used from Phase 2) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's output size AND the DocumentChunk.embedding column (384).
EMBEDDING_DIM=384
# Leave unset for auto (BGE models get their query instruction). Empty = no prefix.
# EMBEDDING_QUERY_PREFIX=
CHUNK_WORDS=200
CHUNK_OVERLAP_WORDS=40
RAG_TOP_K=4
# Cosine-distance cutoff for "relevant" chunks (tuned for bge-small-en-v1.5).
RAG_MAX_DISTANCE=0.45
RAG_HISTORY_TURNS=6

# --- Frontend (used from Phase 5) ---
BACKEND_URL=http://localhost:8000
